[node name="ExplanationParagraph" type="RichTextLabel" parent="MainSection/WelcomeScreen" unique_id=1602137913]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Quick start:
Press \"Start Today's Revision\" to cycle through all the cards that are due to be revised today. Getting a question correct will move it to the next stage, while getting one wrong will reset it to stage 0.

Add a new flashcard by pressing on the \"Add New Card\" button.

Edit a flashcard by pressing the edit button next to the card. Make sure to save your edits before exiting.


What is spaced repetition?
Spaced repetition repeats information, spaced tightly at first, and spaced longer later as you memorise the question. The ratio used for this project is 1-3-7-14-30-60. Currently, this project does not work on real time, but you can press a button to advance time by 'one'."
fit_content = true
horizontal_alignment = 1

